@using RealState.Core.Application.DTOs.PropertyUnit
@using RealState.Core.Application.ViewModels.PropertyUnit
@model List<PropertyCardViewModel>
@{
    ViewData["Title"] = "Propiedades Disponibles";
    Layout = "_LayoutAnonymous";
}

<div class="row mb-4">
    <div class="col-12">
        <h2>Propiedades Disponibles</h2>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Buscar por Código</h5>
            </div>
            <div class="card-body">
                <form asp-controller="Home" asp-action="SearchByCode" method="post" class="row g-3">
                    <div class="col-md-10">
                        <input type="text" name="code" class="form-control" placeholder="Ingrese el código de la propiedad" required />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100"><i class="fas fa-search"></i> Buscar </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">Filtros de Búsqueda</h5>
            </div>
            <div class="card-body">
                <form asp-controller="Home" asp-action="Filter" method="post">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Tipo de Propiedad</label>
                            <select name="PropertyTypeId" class="form-select">
                                <option value="">Todos</option>
                                @if (ViewBag.PropertyTypes != null)
                                {
                                  @foreach (var type in ViewBag.PropertyTypes)
                                  {
                                    var selected = (type.Id == (ViewBag.SelectedPropertyTypeId as int?)) ? "selected" : "";
                                    <option value="@type.Id" selected="@selected">@type.Name</option>
                                  }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Precio Mínimo</label>
                            <input type="number" name="MinPrice" class="form-control" placeholder="0" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Precio Máximo</label>
                            <input type="number" name="MaxPrice" class="form-control" placeholder="0" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Habitaciones</label>
                            <input type="number" name="Bedrooms" class="form-control" placeholder="0" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Baños</label>
                            <input type="number" name="Bathrooms" class="form-control" placeholder="0" />
                        </div>
                        <div class="col-md-9 d-flex align-items-end">
                            <button type="submit" class="btn btn-secondary">
                                <i class="fas fa-filter"></i> Aplicar Filtros
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    @if (Model == null || !Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> No hay propiedades disponibles en este momento.
            </div>
        </div>
    }
    else
    {
        @foreach (var property in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <img src="~/@property.FirstImage" class="card-img-top" alt="@property.PropertyTypeName" style="height: 200px; object-fit: cover;" />
                    <div class="card-body">
                        <span class="badge bg-primary mb-2">@property.PropertyTypeName</span>
                        <span class="badge bg-secondary mb-2">@property.SaleTypeName</span>
                        <h5 class="card-title">Código: @property.CodeProperty</h5>
                        <h4 class="text-success">RD$ @property.Price.ToString("N2")</h4>
                        <ul class="list-unstyled">
                            <li><i class="fas fa-bed"></i> @property.Bedrooms Habitaciones</li>
                            <li><i class="fas fa-bath"></i> @property.Bathrooms Baños</li>
                            <li><i class="fas fa-ruler-combined"></i> @property.SizeM m²</li>
                        </ul>
                    </div>
                    <div class="card-footer">
                        <a asp-controller="Home" asp-action="Details" asp-route-id="@property.Id" class="btn btn-primary w-100">
                            <i class="fas fa-eye"></i> Ver Detalles
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</div>