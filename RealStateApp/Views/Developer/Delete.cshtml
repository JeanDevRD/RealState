@model UserViewModel  

@{
    ViewData["Title"] = "Eliminar Administrador";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card bg-light shadow-lg border-danger rounded-lg mt-5">
                <div class="card-header bg-danger text-white">
                    <h3 class="text-center font-weight-light my-4">Confirmar Eliminación</h3>
                </div>
                <div class="card-body">
                    <p class="text-center lead">
                        ¿Estás seguro de que deseas eliminar al administrador **@Model.FirstName @Model.LastName**?
                    </p>
                    <hr />
                    <dl class="row">
                        <dt class="col-sm-4">ID:</dt>
                        <dd class="col-sm-8">@Model.Id</dd>

                        <dt class="col-sm-4">Nombre de Usuario:</dt>
                        <dd class="col-sm-8">@Model.UserName</dd>

                        <dt class="col-sm-4">Email:</dt>
                        <dd class="col-sm-8">@Model.Email</dd>
                    </dl>

                    <form method="post" asp-controller="Admin" asp-action="DeleteAdmin" class="d-flex justify-content-around mt-4">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-danger">Confirmar Eliminación</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>