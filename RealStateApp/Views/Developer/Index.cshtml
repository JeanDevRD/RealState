@model List<DeveloperViewModel>
@{
    ViewData["Title"] = "Gestión de Desarrolladores";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12 text-end">
            <a asp-controller="Developer" asp-action="Create" class="btn btn-primary">
                Crear Nuevo Desarrollador
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Listado de Desarrolladores</h4>
        </div>
        <div class="card-body">
            @if (Model == null || Model.Count == 0)
            {
                <div class="alert alert-info" role="alert">
                    No hay desarrolladores registrados actualmente.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Cédula</th>
                                <th>Nombre de Usuario</th>
                                <th>Email</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var developer in Model)
                            {
                                <tr>
                                    <td>@developer.Name</td>
                                    <td>@developer.LastName</td>
                                    <td>@developer.IdentityNumber</td>
                                    <td>@developer.UserName</td>
                                    <td>@developer.Email</td>
                                    <td>
                                        <a asp-controller="Developer" asp-action="Edit" asp-route-id="@developer.Id" class="btn btn-sm btn-warning me-2">Editar</a>
                                        <a asp-controller="Developer" asp-action="Delete" asp-route-id="@developer.Id" class="btn btn-sm btn-danger me-2">Eliminar</a>
                                        <a asp-controller="Developer" asp-action="ChangeStatusUser" asp-route-id="@developer.Id" class="btn btn-sm btn-info">Cambiar Estado</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>