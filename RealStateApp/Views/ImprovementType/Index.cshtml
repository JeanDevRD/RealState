@model List<ImprovementTypeViewModel>
@{
    ViewData["Title"] = "Gestión de Tipos de Mejoras";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Tipos de Mejoras</h4>
                    <a asp-controller="ImprovementType" asp-action="Create" class="btn btn-success">
                        <i class="fas fa-plus-circle me-1"></i> Crear Nuevo
                    </a>
                </div>

                <div class="card-body">
                    @if (Model == null || Model.Count == 0)
                    {
                        <div class="alert alert-info text-center" role="alert">
                            No hay Tipos de Mejoras registrados.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Descripción</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.Name</td>
                                            <td>@item.Description</td>
                                            <td class="text-center">
                                                <a asp-controller="ImprovementType" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-2" title="Editar">
                                                    <i class="fas fa-edit"></i> Editar
                                                </a>
                                                <a asp-controller="ImprovementType" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Eliminar">
                                                    <i class="fas fa-trash-alt"></i> Eliminar
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
