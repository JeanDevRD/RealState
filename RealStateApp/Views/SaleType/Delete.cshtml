@model SaleTypeViewModel
@{
    ViewData["Title"] = "Eliminar Tipo de pago";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow-lg">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Confirmación de Eliminación</h4>
                </div>
                <div class="card-body">
                    <h5 class="card-title text-danger">¿Estás seguro de que deseas eliminar este Tipo de pago</h5>
                    <p class="card-text">
                        Esta acción es irreversible. Estás a punto de eliminar:
                    </p>
                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item"><strong>Nombre:</strong> @Model.Name</li>
                        <li class="list-group-item"><strong>Descripción:</strong> @Model.Description</li>
                    </ul>

                    <form method="post" asp-controller="SaleType" asp-action="DeleteSale">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger me-2">
                            <i class="fas fa-trash"></i> Confirmar Eliminación
                        </button>
                        <a asp-controller="SaleType" asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times-circle"></i> Cancelar
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>