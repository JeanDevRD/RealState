@using RealState.Core.Application.ViewModels.Admin
@model AdminViewModel  

@{
    ViewData["Title"] = "Cambiar Estado de Administrador";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card bg-light shadow-lg border-info rounded-lg mt-5">
                <div class="card-header bg-info text-white">
                    <h3 class="text-center font-weight-light my-4">Cambiar Estado de Usuario</h3>
                </div>
                <div class="card-body">
                    <p class="text-center lead">
                        El estado actual del administrador **@Model.Name @Model.LastName** es: **[Aquí debería ir el estado actual (Activo/Inactivo)]**.
                    </p>
                    <p class="text-center">
                        ¿Estás seguro de que deseas cambiar el estado de este administrador?
                    </p>
                    <hr />

                    <form method="post" asp-controller="Admin" asp-action="ChangeStatusUser" class="d-flex justify-content-around mt-4">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-info">Confirmar Cambio de Estado</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>