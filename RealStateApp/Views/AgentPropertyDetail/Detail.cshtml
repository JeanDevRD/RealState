@using RealState.Core.Application.ViewModels.PropertyUnit
@model PropertyDetailViewModel
@{
    ViewData["Title"] = "Detalle de Propiedad";
    Layout = "_LayoutAgent";
}

<div class="row mb-3">
    <div class="col-12">
        <a asp-controller="HomeAgent" asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Volver a Mis Propiedades
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">

        <div class="card mb-4">
            <div id="propertyCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @for (int i = 0; i < Model.Images.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="~/@Model.Images[i]" class="d-block w-100" alt="Imagen @(i + 1)"
                                 style="height: 400px; object-fit: cover;" />
                        </div>
                    }
                </div>
                @if (Model.Images.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#propertyCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#propertyCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Información de la Propiedad</h4>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Código:</strong> @Model.CodeProperty
                    </div>
                    <div class="col-md-6">
                        <strong>Estado:</strong>
                        @if (Model.StateProperty == 0)
                        {
                            <span class="badge bg-success">Disponible</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Vendida</span>
                        }
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Tipo:</strong> @Model.PropertyTypeName
                    </div>
                    <div class="col-md-6">
                        <strong>Tipo de Venta:</strong> @Model.SalesName
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-12">
                        <h4 class="text-success">RD$ @Model.Price.ToString("N2")</h4>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <i class="fas fa-bed"></i> <strong>Habitaciones:</strong> @Model.Bedrooms
                    </div>
                    <div class="col-md-4">
                        <i class="fas fa-bath"></i> <strong>Baños:</strong> @Model.Bathrooms
                    </div>
                    <div class="col-md-4">
                        <i class="fas fa-ruler-combined"></i> <strong>Tamaño:</strong> @Model.SizeM m²
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-12">
                        <strong>Descripción:</strong>
                        <p class="mt-2">@Model.Description</p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <strong>Mejoras:</strong>
                        <div class="mt-2">
                            @foreach (var improvement in Model.ImprovementTypesNames)
                            {
                                <span class="badge bg-info me-1 mb-1">@improvement</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-comments"></i> Mensajes de Clientes</h5>
            </div>
            <div class="card-body">
                @if (Model.Chats == null || !Model.Chats.Any())
                {
                    <p class="text-muted">No hay conversaciones con clientes para esta propiedad.</p>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var chat in Model.Chats)
                        {
                            <a asp-controller="Chat" asp-action="Detail" asp-route-chatId="@chat.Id"
                               class="list-group-item list-group-item-action">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">
                                        <i class="fas fa-user"></i> @chat.NameClient
                                    </h6>
                                    <small><i class="fas fa-arrow-right"></i></small>
                                </div>
                                <small class="text-muted">Click para ver conversación</small>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0"><i class="fas fa-hand-holding-usd"></i> Ofertas Recibidas</h5>
            </div>
            <div class="card-body">
                @if (Model.ClientWithOffer == null || !Model.ClientWithOffer.Any())
                {
                    <p class="text-muted">No hay ofertas para esta propiedad.</p>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var clientOffer in Model.ClientWithOffer)
                        {
                            var hasPending = clientOffer.PropertyOffers.Any(o => o.OfferStatus == 0);
                            <a asp-controller="AgentOffer" asp-action="ClientOffers"
                               asp-route-clientId="@clientOffer.PropertyOffers.First().IdClient"
                               asp-route-propertyId="@Model.Id"
                               class="list-group-item list-group-item-action @(hasPending ? "list-group-item-warning" : "")">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">
                                        <i class="fas fa-user"></i> @clientOffer.NameClient
                                    </h6>
                                    @if (hasPending)
                                    {
                                        <span class="badge bg-warning text-dark">Pendiente</span>
                                    }
                                </div>
                                <small>Total de ofertas: @clientOffer.PropertyOffers.Count</small>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>