@using RealState.Core.Application.ViewModels.PropertyUnit
@using RealState.Core.Application.ViewModels.PropertyType
@using RealState.Core.Application.ViewModels.SalesType
@model SavePropertyViewModel
@{
    ViewData["Title"] = "Editar Propiedad";
    Layout = "_LayoutAgent";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card shadow">
            <div class="card-header bg-warning text-dark">
                <h3 class="mb-0"><i class="fas fa-edit"></i> Editar Propiedad</h3>
            </div>
            <div class="card-body">
                <form asp-controller="PropertyManagement" asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />

                    <h5 class="mb-3"><i class="fas fa-info-circle"></i> Información Básica</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Tipo de Propiedad </label>
                            <select asp-for="PropertyTypeId" class="form-select">
                                @foreach (PropertyTypeViewModel type in (List<PropertyTypeViewModel>)ViewBag.PropertyTypes)
                                {
                                    <option value="@type.Id">@type.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Tipo de Venta </label>
                            <select asp-for="SaleTypeId" class="form-select">
                                @foreach (SaleTypeViewModel type in (List<SaleTypeViewModel>)ViewBag.SaleTypes)
                                {
                                    <option value="@type.Id">@type.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Price" class="form-label">Precio (RD$) *</label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="SizeM" class="form-label">Tamaño (m²) *</label>
                            <input asp-for="SizeM" type="number" step="0.01" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Bedrooms" class="form-label">Habitaciones *</label>
                            <input asp-for="Bedrooms" type="number" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Bathrooms" class="form-label">Baños *</label>
                            <input asp-for="Bathrooms" type="number" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Descripción *</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    </div>

                    <hr />
                    <h5 class="mb-3"><i class="fas fa-star"></i> Mejoras</h5>
                    <div class="mb-3">
                        <div class="row">
                            @foreach (var improvement in (List<ImprovementTypeViewModel>)ViewBag.Improvements)
                            {
                                <div class="col-md-4 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               name="ImprovementTypeIds" value="@improvement.Id"
                                               id="improvement_@improvement.Id" />
                                        <label class="form-check-label" for="improvement_@improvement.Id">
                                            @improvement.Name
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    @if (Model.ExistingImages != null && Model.ExistingImages.Any())
                    {
                        <hr />
                        <h5 class="mb-3"><i class="fas fa-images"></i> Imágenes Actuales</h5>
                        <div class="row mb-3">
                            @foreach (var image in Model.ExistingImages)
                            {
                                <div class="col-md-3 mb-2">
                                    <img src="~/@image" class="img-thumbnail" alt="Imagen de propiedad" />
                                </div>
                            }
                        </div>
                    }

                    <hr />
                    <h5 class="mb-3"><i class="fas fa-upload"></i> Cambiar Imágenes (Opcional)</h5>
                    <div class="mb-3">
                        <input type="file" name="images" accept="image/*" multiple class="form-control" />
                        <small class="text-muted">Si subes nuevas imágenes, reemplazarán las actuales (1-4 imágenes)</small>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                        <a asp-controller="PropertyManagement" asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-save"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}