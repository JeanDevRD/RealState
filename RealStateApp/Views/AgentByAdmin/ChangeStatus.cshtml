@model string

@{
    ViewData["Title"] = "Confirmar Cambio de Estado";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow p-4 mt-5">
                <div class="card-body text-center">
                    <h4 class="card-title text-warning">Advertencia</h4>
                    <p class="card-text">¿Estás seguro de que deseas **cambiar el estado** de este agente?</p>
                    <p class="text-muted small">Esto invertirá su estado actual (Activo/Inactivo).</p>

                    <form asp-controller="AgentByAdmin" asp-action="ChangeStatusUser" method="post">
                        <input type="hidden" name="id" value="@Model" />

                        <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-4">
                            <button type="submit" class="btn btn-warning">Confirmar Cambio</button>
                            <a asp-controller="AgentByAdmin" asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>