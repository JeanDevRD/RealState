@model List<AgentViewModel>

@{
    ViewData["Title"] = "Gestión de Agentes";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <h2>Gestión de Agentes</h2>
            <p>Lista de todos los agentes del sistema.</p>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-body">
            @if (Model == null || Model.Count == 0)
            {
                <div class="alert alert-warning" role="alert">
                    No se encontraron agentes.
                </div>
            }
            else
            {
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Nombre Completo</th>
                            <th>Email</th>
                            <th>Propiedades</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var agent in Model)
                        {
                            <tr>
                                <td>@agent.Name @agent.LastName</td>
                                <td>@agent.Email</td>
                                <td>@agent.TotalProperties</td>
                                <td>
                                    <span class="badge @(agent.IsActive ? "bg-success" : "bg-danger")">
                                        @(agent.IsActive ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td>
                                    <a asp-controller="AgentByAdmin" asp-action="ChangeStatus" asp-route-IdUser="@agent.Id" class="btn btn-sm btn-info">
                                        Cambiar Estado
                                    </a>
                                    <a asp-controller="AgentByAdmin" asp-action="Delete" asp-route-id="@agent.Id" class="btn btn-sm btn-danger">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>