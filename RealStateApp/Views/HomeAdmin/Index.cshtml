@model RealState.Core.Application.ViewModels.HomeAdmin.HomeAdminViewModel

@{
    ViewData["Title"] = "Panel de Administración";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="display-4 text-center mb-5">
                <i class="fas fa-tachometer-alt"></i> Panel de Administración
            </h1>
            <hr>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">
                                <i class="fas fa-building"></i> Propiedades Disponibles
                            </div>
                            <div class="h5 mb-0 font-weight-bold">
                                @Model.PropertyUnitCount
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-home fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">
                                <i class="fas fa-user-tie"></i> Agentes Registrados
                            </div>
                            <div class="h5 mb-0 font-weight-bold">
                                @Model.AgentCount
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-white shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">
                                <i class="fas fa-user"></i> Clientes Potenciales
                            </div>
                            <div class="h5 mb-0 font-weight-bold">
                                @Model.ClientCount
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-handshake fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card bg-info text-white shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">
                                <i class="fas fa-cogs"></i> Desarrolladores Activos
                            </div>
                            <div class="h5 mb-0 font-weight-bold">
                                @Model.DeveloperCount
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-laptop-code fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12 text-center">
            <p class="text-muted">
                Este es el resumen principal de las entidades en la aplicación.
            </p>
        </div>
    </div>
</div>