@using RealState.Core.Application.ViewModels.PropertyUnit
@model PropertyUnitViewModel
@{
    ViewData["Title"] = "Eliminar Propiedad";
    Layout = "_LayoutAgent";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow border-danger">
            <div class="card-header bg-danger text-white">
                <h3 class="mb-0"><i class="fas fa-exclamation-triangle"></i> Confirmar Eliminación</h3>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle"></i>
                    <strong>¡Advertencia!</strong> Esta acción no se puede deshacer.
                </div>

                <p class="lead">¿Estás seguro de que deseas eliminar esta propiedad?</p>

                <div class="card mb-3">
                    <div class="row g-0">
                        @if (Model.FirstImage != null && Model.FirstImage.Any())
                        {
                            <div class="col-md-4">
                                <img src="@Model.FirstImage class="img-fluid rounded-start"
                                     alt="Propiedad" style="height: 200px; object-fit: cover;" />
                            </div>
                        }
                        <div class="col-md-8">
                            <div class="card-body">
                                <h5 class="card-title">Código: @Model.CodeProperty</h5>
                                <p class="card-text">
                                    <strong>Precio:</strong> <span class="text-success">RD$ @Model.Price.ToString("N2")</span><br />
                                </p>
                                <ul class="list-unstyled">
                                    <li><i class="fas fa-bed"></i> @Model.Bedrooms Habitaciones</li>
                                    <li><i class="fas fa-bath"></i> @Model.Bathrooms Baños</li>
                                    <li><i class="fas fa-ruler-combined"></i> @Model.SizeM m²</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <form asp-controller="PropertyManagement" asp-action="DeleteConfirmed" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-controller="PropertyManagement" asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-danger"
                                onclick="return confirm('¿Realmente deseas eliminar esta propiedad? Esta acción es irreversible.')">
                            <i class="fas fa-trash"></i> Confirmar Eliminación
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>