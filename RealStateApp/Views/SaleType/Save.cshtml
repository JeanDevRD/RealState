@model SaveSaleTypeViewModel
@{
    bool editMode = ViewBag.EditMode ?? false;
    ViewData["Title"] = editMode ? "Editar Tipo de pago" : "Nuevo Tipo de pago";
        Layout = "_LayoutAdmin";
}

<div class="row mt-4">
    <div class="col-12 col-md-6 offset-md-3">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="text-center">@(editMode ? "Editar - " : "Nuevo - ") Tipo de Pago</h5>
            </div>
            <div class="card-body">

                <form asp-controller="SaleType" asp-action="@(editMode ? "Edit" : "Create")" method="post">

                    <input asp-for="Id" type="hidden" />
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Nombre:</label>
                        <input asp-for="Name" type="text" class="form-control"/>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Descripción:</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Descripción breve del tipo de pago"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <a asp-controller="PropertyType" asp-action="Index" class="btn btn-outline-secondary btn-sm me-2">
                            <i class="fas fa-arrow-left"></i> Volver a Tipos
                        </a>
                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-save"></i> @(editMode ? "Guardar Cambios" : "Crear Tipo")
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>